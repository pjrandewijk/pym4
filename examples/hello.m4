divert(-1)
# Run with:  pym4 examples/hello.m4   (CI compares the output with GNU m4)
define(`greet', `Hello, $1!')
define(`count', `ifelse(eval($1 <= $2), 1, `$1 count(incr($1), $2)')')
define(`upper', `translit(`$1', `a-z', `A-Z')')
define(`ohms', `patsubst(`$1', `R\([0-9]+\)', `\1 ohm')')
divert(0)dnl
greet(`world')
count(1, 5)
eval(2**10) eval(7/2) eval(-7%3) eval(0x1F, 2)
upper(`circuit macros')
ohms(`R1 R22 R333')
regexp(`GNU m4 1.4.21', `\([0-9]+\.[0-9.]+\)', `version \1')
len(`pym4') index(`abcdef', `cd') substr(`pppic', 2)
format(`%5.2f|%-4s|%03d', 3.14159, `ab', 7)
ifdef(`__gnu__', `GNU extensions on')
